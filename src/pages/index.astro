---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Grille from '../components/Grille.astro';
import logo from '../assets/logo-art-of-sev.png';
import { CATEGORIES, SITE } from '../site';
import { toutesLesOeuvres } from '../oeuvres';

const oeuvres = await toutesLesOeuvres();
const aLaUne = oeuvres.filter((o) => o.data.accueil).slice(0, 6);
const couverture = (id: string) => oeuvres.find((o) => o.data.categorie === id);
---
<Base
  title={SITE.nom}
  description="Art of Sev, artiste à Dardilly près de Lyon : dessin, peinture, textile, sculpture, bijoux et objets décoratifs faits main. Œuvres à vendre et créations sur commande."
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-texte">
        <p class="eyebrow">Artiste à Dardilly, près de Lyon</p>
        <h1>Des créations faites main, pleines de couleurs</h1>
        <p class="lead">
          Dessin, peinture, textile, sculpture, bijoux et petits objets décoratifs : chaque pièce est unique.
          Découvrez mon univers, achetez une œuvre ou commandez une création sur mesure.
        </p>
        <div class="btn-row">
          <a class="btn" href="/galerie/">Voir la galerie</a>
          <a class="btn btn--ghost" href="/contact/">Me contacter</a>
        </div>
      </div>
      <Image class="hero-logo" src={logo} alt="Logo Art of Sev" widths={[280, 420, 560]} sizes="(max-width: 760px) 70vw, 420px" loading="eager" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">À la une</p>
      <h2>Mes dernières créations</h2>
      <Grille oeuvres={aLaUne} afficherCategorie />
      <p class="plus"><a class="btn btn--ghost" href="/galerie/">Toute la galerie</a></p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">Mes univers</p>
      <h2>Six façons de créer</h2>
      <div class="univers">
        {CATEGORIES.map((c) => {
          const o = couverture(c.id);
          return (
            <a class="tuile" href={`/galerie/${c.id}/`}>
              {o && (
                <Picture src={o.data.image} alt="" widths={[300, 480]} sizes="(max-width: 600px) 46vw, 220px" formats={['avif', 'webp']} />
              )}
              <span class={o ? '' : 'seul'}>{c.nom}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container appel">
      <h2>Une idée, un cadeau, une commande ?</h2>
      <p class="lead">Je crée aussi sur mesure : portrait, bijou personnalisé, objet pour votre intérieur. Écrivez-moi, je vous réponds rapidement.</p>
      <a class="btn" href="/contact/">Demander une création</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(32px, 6vw, 72px); }
  .hero-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: 32px; align-items: center; }
  .hero-texte { min-width: 0; }
  .hero-logo { width: 100%; max-width: 420px; justify-self: center; }
  @media (max-width: 760px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-logo { order: -1; max-width: 260px; }
  }
  .plus { margin-top: 36px; text-align: center; }
  .univers { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: 16px; }
  .tuile {
    position: relative; display: block; aspect-ratio: 1; border-radius: var(--radius); overflow: hidden;
    text-decoration: none; background: var(--teal);
  }
  .tuile :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .tuile:hover :global(img) { transform: scale(1.05); }
  .tuile span {
    position: absolute; inset: auto 0 0 0; padding: 28px 14px 12px;
    background: linear-gradient(transparent, rgba(20, 30, 32, 0.78));
    color: #fff; font-family: var(--f-title); font-size: 1.2rem; font-weight: 600;
  }
  .tuile span.seul { inset: 0; display: grid; place-items: center; text-align: center; background: none; padding: 14px; }
  .tuile:nth-child(3n + 2) { background: var(--pink); }
  .tuile:nth-child(3n) { background: var(--orange); }
  .appel { text-align: center; display: grid; justify-items: center; }
</style>
