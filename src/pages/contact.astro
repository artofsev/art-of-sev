---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const sujetParDefaut = 'Demande depuis le site Sev Créations';
const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent(sujetParDefaut)}`;
---
<Base
  title="Contact"
  description="Contactez Sev Créations, artiste à Dardilly près de Lyon : achat d'une œuvre, création sur commande, cours, exposition ou simple question."
>
  <section class="section">
    <div class="container contact">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Écrivez-moi</h1>
        <p class="lead">Une œuvre vous plaît, vous avez une idée de création sur mesure, une question sur les cours ? Je vous réponds avec plaisir.</p>
        <ul class="coord">
          <li><span>Atelier</span>{SITE.ville}, {SITE.region}</li>
          {SITE.instagram && <li><span>Instagram</span><a href={SITE.instagram} target="_blank" rel="noopener">{SITE.instagramPseudo}</a></li>}
        </ul>
      </div>

      <div class="carte-mail">
        <h2>Par e-mail</h2>
        <p>Cliquez sur le bouton : votre messagerie s'ouvre avec mon adresse déjà remplie.</p>
        <a id="ecrire" class="btn" href={mailto} data-email={SITE.email} data-sujet={sujetParDefaut}>M'écrire un e-mail</a>
        <p class="ou">ou copiez mon adresse :</p>
        <div class="adresse">
          <span id="adresse">{SITE.email}</span>
          <button id="copier" type="button" class="btn btn--ghost">Copier</button>
        </div>
        <p id="statut" class="statut" role="status"></p>
        <p class="astuce"><strong>Paiement :</strong> {SITE.paiement}</p>
        <p class="astuce">Pour une demande sur une œuvre, n'hésitez pas à indiquer son titre. Pour une commande, décrivez votre idée : taille, couleurs, délai.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  const lien = document.getElementById('ecrire') as HTMLAnchorElement;
  const email = lien.dataset.email!;
  const params = new URLSearchParams(location.search);
  const oeuvre = params.get('oeuvre');
  let sujet = lien.dataset.sujet!;
  let corps = '';

  // Arrivée depuis une œuvre ou la page Cours : on prépare le message.
  if (oeuvre) {
    sujet = `Œuvre « ${oeuvre} »`;
    corps = `Bonjour, je suis intéressé(e) par l'œuvre « ${oeuvre} ».\n\n`;
  } else if (params.get('sujet') === 'cours') {
    sujet = 'Cours ou animation';
    corps = 'Bonjour, je souhaite des informations sur vos cours / animations.\n\n';
  }
  lien.href = `mailto:${email}?subject=${encodeURIComponent(sujet)}${corps ? `&body=${encodeURIComponent(corps)}` : ''}`;

  const statut = document.getElementById('statut')!;
  document.getElementById('copier')!.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email);
      statut.textContent = 'Adresse copiée !';
    } catch {
      const sel = window.getSelection();
      const range = document.createRange();
      range.selectNodeContents(document.getElementById('adresse')!);
      sel?.removeAllRanges();
      sel?.addRange(range);
      statut.textContent = 'Adresse sélectionnée : faites Ctrl+C (ou Copier).';
    }
  });
</script>

<style>
  .contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  @media (max-width: 820px) { .contact { grid-template-columns: 1fr; gap: 28px; } }
  .coord { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 12px; }
  .coord li { display: grid; }
  .coord span { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .carte-mail {
    display: grid; gap: 14px; justify-items: start; background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); padding: clamp(20px, 4vw, 32px); border-top: 5px solid var(--pink);
  }
  .carte-mail h2, .carte-mail p { margin: 0; }
  .carte-mail > p { color: var(--muted); }
  .ou { font-size: 0.95rem; }
  .adresse { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .adresse span { font-weight: 600; overflow-wrap: anywhere; min-width: 0; }
  .adresse .btn { padding: 0.45em 1.1em; }
  .statut { font-weight: 600; color: var(--teal) !important; min-height: 1.5em; }
  .astuce { font-size: 0.95rem; }
</style>
