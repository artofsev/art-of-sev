---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
---
<Base
  title="Contact"
  description="Contactez Art of Sev, artiste à Dardilly près de Lyon : achat d'une œuvre, création sur commande, exposition ou simple question."
>
  <section class="section">
    <div class="container contact">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Écrivez-moi</h1>
        <p class="lead">Une œuvre vous plaît, vous avez une idée de création sur mesure ou une question ? Je vous réponds avec plaisir.</p>
        <ul class="coord">
          <li><span>E-mail</span><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><span>Instagram</span><a href={SITE.instagram} target="_blank" rel="noopener">{SITE.instagramPseudo}</a></li>
          <li><span>Atelier</span>{SITE.ville}, {SITE.region}</li>
        </ul>
      </div>

      <form id="formulaire" class="formulaire" action={`https://formsubmit.co/ajax/${SITE.email}`} method="POST">
        <label for="nom">Votre nom</label>
        <input id="nom" name="nom" type="text" autocomplete="name" required />

        <label for="email">Votre e-mail</label>
        <input id="email" name="email" type="email" autocomplete="email" required />

        <label for="sujet">Votre demande</label>
        <select id="sujet" name="sujet">
          <option>Acheter une œuvre</option>
          <option>Commander une création</option>
          <option>Exposition ou partenariat</option>
          <option>Autre question</option>
        </select>

        <label for="message">Votre message</label>
        <textarea id="message" name="message" rows="6" required></textarea>

        <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="display:none" />
        <input type="hidden" name="_subject" value="Nouveau message depuis le site Art of Sev" />
        <input type="hidden" name="_template" value="table" />

        <button class="btn" type="submit">Envoyer</button>
        <p id="statut" class="statut" role="status"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('formulaire') as HTMLFormElement;
  const statut = document.getElementById('statut')!;
  const message = document.getElementById('message') as HTMLTextAreaElement;
  const sujet = document.getElementById('sujet') as HTMLSelectElement;

  // Arrivée depuis une œuvre : on prépare le message.
  const oeuvre = new URLSearchParams(location.search).get('oeuvre');
  if (oeuvre) {
    sujet.value = 'Acheter une œuvre';
    message.value = `Bonjour, je suis intéressé(e) par l'œuvre « ${oeuvre} ».\n`;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const bouton = form.querySelector('button')!;
    bouton.disabled = true;
    statut.textContent = 'Envoi en cours…';
    try {
      const rep = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const res = await rep.json().catch(() => ({}));
      if (/activat/i.test(res.message ?? '')) {
        statut.textContent = "Le formulaire doit d'abord être activé : un lien d'activation vient d'être envoyé à l'adresse de l'artiste.";
        return;
      }
      if (!rep.ok || String(res.success) === 'false') throw new Error();
      form.reset();
      statut.textContent = 'Merci ! Votre message est bien envoyé. Je vous réponds au plus vite.';
    } catch {
      statut.textContent = "Le message n'a pas pu partir. Réessayez ou écrivez-moi directement par e-mail.";
    } finally {
      bouton.disabled = false;
    }
  });
</script>

<style>
  .contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 48px; align-items: start; }
  @media (max-width: 820px) { .contact { grid-template-columns: 1fr; gap: 28px; } }
  .coord { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 12px; }
  .coord li { display: grid; }
  .coord span { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .coord a { overflow-wrap: anywhere; }
  .formulaire {
    display: grid; gap: 6px; background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); padding: clamp(20px, 4vw, 32px);
  }
  label { font-weight: 600; margin-top: 10px; }
  input, select, textarea {
    font: inherit; color: var(--ink); background: var(--bg); width: 100%;
    border: 1.5px solid var(--line); border-radius: 10px; padding: 0.7em 0.9em;
  }
  input:focus, select:focus, textarea:focus { border-color: var(--teal); outline: none; box-shadow: 0 0 0 3px rgba(11, 110, 115, 0.18); }
  .formulaire .btn { margin-top: 18px; justify-self: start; }
  .statut { margin: 8px 0 0; font-weight: 600; color: var(--teal); }
</style>
