---
import type { CollectionEntry } from 'astro:content';
import Carte from './Carte.astro';

interface Props {
  oeuvres: CollectionEntry<'oeuvres'>[];
  afficherCategorie?: boolean;
}
const { oeuvres, afficherCategorie } = Astro.props;
---
<div class="grille">
  {oeuvres.map((o) => <Carte oeuvre={o} afficherCategorie={afficherCategorie} />)}
</div>

<style>
  .grille {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 36px 24px;
  }
</style>
