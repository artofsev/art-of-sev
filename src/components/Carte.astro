---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../site';

interface Props {
  oeuvre: CollectionEntry<'oeuvres'>;
  afficherCategorie?: boolean;
}
const { oeuvre, afficherCategorie = false } = Astro.props;
const d = oeuvre.data;
const categorie = CATEGORIES.find((c) => c.id === d.categorie)?.nom;
---
<a class="carte" href={`/oeuvre/${oeuvre.id}/`}>
  <div class="cadre">
    <Picture
      src={d.image}
      alt={`${d.titre}, ${d.technique ?? categorie} par Sev Créations`}
      widths={[360, 560, 800]}
      sizes="(max-width: 600px) 92vw, (max-width: 1000px) 46vw, 340px"
      formats={['avif', 'webp']}
    />
  </div>
  <div class="infos">
    {afficherCategorie && <span class="cat">{categorie}</span>}
    <span class="titre">{d.titre}</span>
    {d.technique && <span class="tech">{d.technique}</span>}
    {d.disponible && <span class="dispo">Disponible</span>}
  </div>
</a>

<style>
  .carte { display: grid; gap: 12px; text-decoration: none; color: var(--ink); }
  .cadre {
    aspect-ratio: 1;
    padding: 12px;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--soft);
  }
  .cadre :global(img) { width: 100%; height: 100%; object-fit: contain; transition: transform 0.4s ease; }
  .carte:hover .cadre :global(img) { transform: scale(1.04); }
  .infos { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }
  .cat { width: 100%; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--pink); }
  .titre { font-family: var(--f-title); font-size: 1.15rem; font-weight: 600; }
  .carte:hover .titre { color: var(--pink); }
  .tech { width: 100%; color: var(--muted); font-size: 0.95rem; }
  .dispo {
    font-size: 0.75rem; font-weight: 600; color: var(--teal);
    border: 1.5px solid var(--teal); border-radius: 999px; padding: 1px 9px;
  }
</style>
